# 归档目录：不纳入 git
jiu/

# 凭证与运行数据
data/
!data/.gitkeep
logs/
backups/

# 凭证文件兜底（防止 --out 自定义路径 / 误放置把凭证带进仓库；
# 已跟踪的 cpa-plugin/examples/mimo.json 不受影响，gitignore 只管未跟踪文件）
sso-session.json
chrome-aes-key.bin
local-creds.json
Cookies
mimo.json
mimo-*.json
auth/
*.bin
*.db

# 通用
node_modules/
__pycache__/
*.log
.DS_Store

# 开发资料：不入公开仓库（本地保留；公开仓库只留构建/运行必要源码与必要文档）
AGENT.md
AGENTS.md
test/
docs/investigation-*.md

# 测试运行产物（截图 / 探针输出，跑 test/ 下脚本时生成）
test/output/
test/shots/

# CPA 插件构建产物（不提交二进制，用 make package 重新生成）
cpa-plugin/dist/
cpa-plugin/*.so
cpa-plugin/*.dll
cpa-plugin/*.dylib
cpa-plugin/*.exe
